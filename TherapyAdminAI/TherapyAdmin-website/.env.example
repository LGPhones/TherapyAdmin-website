# TherapyAdmin AI Configuration Template

# Server Configuration
PORT=3000
APP_URL=http://localhost:3000

# Security Secrets (use high-entropy keys in production)
JWT_SECRET=super-secret-jwt-key-replace-in-production-12345
SESSION_SECRET=super-secret-session-key-replace-in-production-12345

# Database Configuration (falls back to local SQLite if left empty)
# DATABASE_URL=postgres://username:password@localhost:5432/therapyadmin

# Google Gemini API Key (for server-side AI generation)
GEMINI_API_KEY=your-anthropic-api-key-here

# Stripe Integration Configuration
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PRICE_STARTER=price_starter_mock
PRICE_PRO=price_pro_mock
PRICE_GROUP=price_group_mock

# OAuth Google Configuration
GOOGLE_CLIENT_ID=google-client-id-here
GOOGLE_CLIENT_SECRET=google-client-secret-here

# OAuth Microsoft Configuration
MICROSOFT_CLIENT_ID=microsoft-client-id-here
MICROSOFT_CLIENT_SECRET=microsoft-client-secret-here

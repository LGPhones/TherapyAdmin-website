// ============================================================
// TherapyAdmin AI — server.js
// Express Server & Entrypoint
// ============================================================

const express = require('express');
const cors = require('cors');
const path = require('path');
const crypto = require('crypto');
const rateLimit = require('express-rate-limit');
const axios = require('axios');

// Load environment variables via our custom DB loader
const db = require('./db');
const auth = require('./auth');
const mfa = require('./mfa');
const ai = require('./ai');
const billing = require('./billing');
const tor = require('./tor');

const app = express();
const PORT = process.env.PORT || 3000;

// Initialize Database Schemas
db.initDb().catch(err => {
  console.error('[DB INIT FATAL]', err);
  process.exit(1);
});

// ── MIDDLEWARES ───────────────────────────────────────────────

// Standard CORS configuration
app.use(cors({
  origin: process.env.APP_URL || 'http://localhost:3000',
  credentials: true
}));

// Express limits for raw body for Webhooks (MUST be before JSON middleware)
app.post('/api/stripe/webhook', express.raw({ type: 'application/json' }), async (req, res) => {
  const sig = req.headers['stripe-signature'];
  try {
    const result = await billing.handleWebhook(req.body, sig);
    res.json(result);
  } catch (err) {
    console.error('[WEBHOOK ERROR]', err.message);
    res.status(400).send(`Webhook Error: ${err.message}`);
  }
});

// Regular Express Parsers
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

// Custom lightweight cookie parser middleware (avoiding external dependency)
app.use((req, res, next) => {
  req.cookies = {};
  const cookieHeader = req.headers.cookie;
  if (cookieHeader) {
    cookieHeader.split(';').forEach(cookie => {
      const parts = cookie.split('=');
      const name = parts[0].trim();
      const val = parts.slice(1).join('=').trim();
      req.cookies[name] = decodeURIComponent(val);
    });
  }
  next();
});

// Rate limiting for auth and brute-force protection
const authLimiter = rateLimit({
  windowMs: 15 * 60 * 1000, // 15 mins
  max: 30, // limit each IP to 30 requests per windowMs
  message: { error: 'Too many authentication attempts, please try again later.' },
  standardHeaders: true,
  legacyHeaders: false
});

// General API rate limiter
const apiLimiter = rateLimit({
  windowMs: 5 * 60 * 1000, // 5 mins
  max: 100, // limit each IP to 100 requests per 5 mins
  standardHeaders: true,
  legacyHeaders: false
});

// ── HELPERS ───────────────────────────────────────────────────

function sanitizeUser(user) {
  if (!user) return null;
  return {
    id: user.id,
    email: user.email,
    name: user.name,
    practice: user.practice,
    phone: user.phone,
    insurance: user.insurance,
    style: user.style,
    specialties: user.specialties ? (typeof user.specialties === 'string' ? JSON.parse(user.specialties) : user.specialties) : [],
    modalities: user.modalities ? (typeof user.modalities === 'string' ? JSON.parse(user.modalities) : user.modalities) : [],
    voiceInstruction: user.voice_instruction,
    mfaEnabled: user.mfa_enabled === 1,
    onboarded: user.onboarded === 1,
    plan: user.plan,
    trialEndsAt: user.trial_ends_at
  };
}

function setAuthCookies(res, accessToken, refreshTokenStr, isSecure) {
  // Set Access Token cookie (15 mins)
  res.cookie('access_token', accessToken, {
    httpOnly: true,
    secure: isSecure,
    sameSite: 'strict',
    maxAge: 15 * 60 * 1000 // 15 minutes
  });

  if (refreshTokenStr) {
    // Set Refresh Token cookie (7 days)
    res.cookie('refresh_token', refreshTokenStr, {
      httpOnly: true,
      secure: isSecure,
      sameSite: 'strict',
      maxAge: 7 * 24 * 60 * 60 * 1000 // 7 days
    });
  }
}

function clearAuthCookies(res) {
  res.clearCookie('access_token');
  res.clearCookie('refresh_token');
}

// ── AUTH ROUTES ───────────────────────────────────────────────

/**
 * Register a new practitioner account
 */
app.post('/auth/signup', authLimiter, async (req, res) => {
  const { email, password, name } = req.body;
  if (!email || !password) {
    return res.status(400).json({ error: 'Email and password are required' });
  }

  try {
    const existing = await db.getUserByEmail(email);
    if (existing) {
      return res.status(409).json({ error: 'User already exists' });
    }

    const passwordHash = auth.hashPassword(password);
    const userId = await db.createUser({
      email,
      passwordHash,
      name,
      onboarded: 0,
      plan: 'trial'
    });

    console.log(`[AUTH] Registered new user ${email} (ID: ${userId})`);
    return res.json({ success: true, message: 'Signup successful' });
  } catch (err) {
    console.error('[SIGNUP ERROR]', err);
    return res.status(500).json({ error: 'Signup failed due to internal error' });
  }
});

/**
 * Log in to account
 */
app.post('/auth/login', authLimiter, async (req, res) => {
  const { email, password } = req.body;
  if (!email || !password) {
    return res.status(400).json({ error: 'Email and password are required' });
  }

  try {
    const user = await db.getUserByEmail(email);
    if (!user || !auth.verifyPassword(password, user.password_hash)) {
      return res.status(401).json({ error: 'Invalid email or password' });
    }

    const isSecure = req.secure || process.env.NODE_ENV === 'production';

    // If MFA is enabled, generate a temporary verification token
    if (user.mfa_enabled === 1) {
      const tempToken = auth.generateAccessToken(user, false); // mfaVerified = false
      setAuthCookies(res, tempToken, null, isSecure);
      return res.json({
        accessToken: tempToken,
        user: sanitizeUser(user),
        mfaRequired: true
      });
    }

    // Standard flow (MFA disabled)
    const accessToken = auth.generateAccessToken(user, false);
    const refreshTokenStr = crypto.randomBytes(40).toString('hex');
    const expiresAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000); // 7 days

    await db.saveRefreshToken(user.id, refreshTokenStr, expiresAt);
    setAuthCookies(res, accessToken, refreshTokenStr, isSecure);

    return res.json({
      accessToken,
      user: sanitizeUser(user),
      mfaRequired: false
    });
  } catch (err) {
    console.error('[LOGIN ERROR]', err);
    return res.status(500).json({ error: 'Authentication failed' });
  }
});

/**
 * Refresh access token
 */
app.post('/auth/refresh', async (req, res) => {
  const refreshTokenStr = req.cookies.refresh_token;
  if (!refreshTokenStr) {
    // If no refresh token, check if we have a temporary access token with MFA pending
    const accessTokenStr = req.cookies.access_token;
    if (accessTokenStr) {
      const decoded = auth.verifyJwt(accessTokenStr);
      if (decoded && decoded.mfaVerified === false && decoded.userId) {
        try {
          const user = await db.getUserById(decoded.userId);
          if (user && user.mfa_enabled === 1) {
            return res.json({
              accessToken: accessTokenStr,
              user: sanitizeUser(user),
              mfaRequired: true
            });
          }
        } catch (err) {
          // fall through to 401
        }
      }
    }
    return res.status(401).json({ error: 'Refresh token missing' });
  }

  try {
    const dbToken = await db.getRefreshToken(refreshTokenStr);
    if (!dbToken) {
      return res.status(401).json({ error: 'Invalid refresh token' });
    }

    // Expiry check
    const expiry = new Date(dbToken.expires_at);
    if (Date.now() > expiry.getTime()) {
      await db.deleteRefreshToken(refreshTokenStr);
      clearAuthCookies(res);
      return res.status(401).json({ error: 'Refresh token expired' });
    }

    const user = await db.getUserById(dbToken.user_id);
    if (!user) {
      return res.status(401).json({ error: 'User not found' });
    }

    const isSecure = req.secure || process.env.NODE_ENV === 'production';
    const isMfaCompleted = user.mfa_enabled === 1; // Since refresh is only issued post-MFA
    
    const newAccessToken = auth.generateAccessToken(user, isMfaCompleted);
    setAuthCookies(res, newAccessToken, null, isSecure);

    return res.json({
      accessToken: newAccessToken,
      user: sanitizeUser(user),
      mfaRequired: false
    });
  } catch (err) {
    console.error('[REFRESH ERROR]', err);
    return res.status(500).json({ error: 'Session refresh failed' });
  }
});

/**
 * Log out
 */
app.post('/auth/logout', async (req, res) => {
  const refreshTokenStr = req.cookies.refresh_token;
  try {
    if (refreshTokenStr) {
      await db.deleteRefreshToken(refreshTokenStr);
    }
    clearAuthCookies(res);
    return res.json({ success: true });
  } catch (err) {
    console.error('[LOGOUT ERROR]', err);
    return res.status(500).json({ error: 'Logout failed' });
  }
});

// ── OAUTH ROUTES ──────────────────────────────────────────────

/**
 * Redirect to Google OAuth
 */
app.get('/auth/google', (req, res) => {
  const rootUrl = 'https://accounts.google.com/o/oauth2/v2/auth';
  const options = {
    redirect_uri: `${process.env.APP_URL}/auth/google/callback`,
    client_id: process.env.GOOGLE_CLIENT_ID,
    access_type: 'offline',
    response_type: 'code',
    prompt: 'consent',
    scope: [
      'https://www.googleapis.com/auth/userinfo.profile',
      'https://www.googleapis.com/auth/userinfo.email',
    ].join(' '),
  };

  const queryString = new URLSearchParams(options).toString();
  return res.redirect(`${rootUrl}?${queryString}`);
});

/**
 * Google OAuth Callback
 */
app.get('/auth/google/callback', async (req, res) => {
  const { code } = req.query;
  if (!code) {
    return res.redirect('/login?error=google');
  }

  try {
    // 1. Exchange code for tokens
    const tokenUrl = 'https://oauth2.googleapis.com/token';
    const values = {
      code,
      client_id: process.env.GOOGLE_CLIENT_ID,
      client_secret: process.env.GOOGLE_CLIENT_SECRET,
      redirect_uri: `${process.env.APP_URL}/auth/google/callback`,
      grant_type: 'authorization_code',
    };

    const tokenRes = await axios.post(tokenUrl, new URLSearchParams(values).toString(), {
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    });

    const { id_token, access_token } = tokenRes.data;

    // 2. Get user info from Google
    const userRes = await axios.get(
      `https://www.googleapis.com/oauth2/v1/userinfo?alt=json&access_token=${access_token}`,
      { headers: { Authorization: `Bearer ${id_token}` } }
    );

    const googleUser = userRes.data;
    if (!googleUser.verified_email) {
      return res.status(403).send('Google account not verified');
    }

    // 3. Find or create user in our DB
    let user = await db.getUserByEmail(googleUser.email);
    if (!user) {
      const userId = await db.createUser({
        email: googleUser.email,
        passwordHash: 'oauth_user_' + crypto.randomBytes(8).toString('hex'), 
        name: googleUser.name,
        onboarded: 0,
        plan: 'trial'
      });
      user = await db.getUserById(userId);
    }

    // 4. Log them in
    const isSecure = req.secure || process.env.NODE_ENV === 'production';
    if (user.mfa_enabled === 1) {
      const tempToken = auth.generateAccessToken(user, false);
      setAuthCookies(res, tempToken, null, isSecure);
      return res.redirect('/mfa-verify');
    }

    const accessToken = auth.generateAccessToken(user, false);
    const refreshTokenStr = crypto.randomBytes(40).toString('hex');
    const expiresAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);

    await db.saveRefreshToken(user.id, refreshTokenStr, expiresAt);
    setAuthCookies(res, accessToken, refreshTokenStr, isSecure);

    return res.redirect('/dashboard');
  } catch (err) {
    console.error('[GOOGLE OAUTH ERROR]', err.response?.data || err.message);
    return res.redirect('/login?error=google');
  }
});

/**
 * Redirect to Microsoft OAuth
 */
app.get('/auth/microsoft', (req, res) => {
  const rootUrl = 'https://login.microsoftonline.com/common/oauth2/v2.0/authorize';
  const options = {
    client_id: process.env.MICROSOFT_CLIENT_ID,
    response_type: 'code',
    redirect_uri: `${process.env.APP_URL}/auth/microsoft/callback`,
    response_mode: 'query',
    scope: 'openid profile email User.Read',
    prompt: 'consent',
  };

  const queryString = new URLSearchParams(options).toString();
  return res.redirect(`${rootUrl}?${queryString}`);
});

/**
 * Microsoft OAuth Callback
 */
app.get('/auth/microsoft/callback', async (req, res) => {
  const { code } = req.query;
  if (!code) {
    return res.redirect('/login?error=microsoft');
  }

  try {
    // 1. Exchange code for tokens
    const tokenUrl = 'https://login.microsoftonline.com/common/oauth2/v2.0/token';
    const values = {
      client_id: process.env.MICROSOFT_CLIENT_ID,
      client_secret: process.env.MICROSOFT_CLIENT_SECRET,
      code,
      redirect_uri: `${process.env.APP_URL}/auth/microsoft/callback`,
      grant_type: 'authorization_code',
    };

    const tokenRes = await axios.post(tokenUrl, new URLSearchParams(values).toString(), {
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    });

    const { access_token } = tokenRes.data;

    // 2. Get user info from Microsoft Graph
    const userRes = await axios.get('https://graph.microsoft.com/v1.0/me', {
      headers: { Authorization: `Bearer ${access_token}` },
    });

    const msUser = userRes.data;
    const email = msUser.mail || msUser.userPrincipalName;

    // 3. Find or create user
    let user = await db.getUserByEmail(email);
    if (!user) {
      const userId = await db.createUser({
        email,
        passwordHash: 'oauth_user_' + crypto.randomBytes(8).toString('hex'),
        name: msUser.displayName,
        onboarded: 0,
        plan: 'trial'
      });
      user = await db.getUserById(userId);
    }

    // 4. Log them in
    const isSecure = req.secure || process.env.NODE_ENV === 'production';
    if (user.mfa_enabled === 1) {
      const tempToken = auth.generateAccessToken(user, false);
      setAuthCookies(res, tempToken, null, isSecure);
      return res.redirect('/mfa-verify');
    }

    const accessToken = auth.generateAccessToken(user, false);
    const refreshTokenStr = crypto.randomBytes(40).toString('hex');
    const expiresAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);

    await db.saveRefreshToken(user.id, refreshTokenStr, expiresAt);
    setAuthCookies(res, accessToken, refreshTokenStr, isSecure);

    return res.redirect('/dashboard');
  } catch (err) {
    console.error('[MICROSOFT OAUTH ERROR]', err.response?.data || err.message);
    return res.redirect('/login?error=microsoft');
  }
});

// ── MFA VERIFICATION CHALLENGE ROUTE ──────────────────────────

/**
 * Verify MFA code (during login)
 */
app.post('/api/mfa/verify', authLimiter, async (req, res) => {
  const { code, isBackup } = req.body;
  if (!code) {
    return res.status(400).json({ error: 'MFA verification code is required' });
  }

  // Retrieve temporary access token from auth header or cookie
  let token = null;
  if (req.headers.authorization && req.headers.authorization.startsWith('Bearer ')) {
    token = req.headers.authorization.split(' ')[1];
  } else if (req.cookies && req.cookies.access_token) {
    token = req.cookies.access_token;
  }

  if (!token) {
    return res.status(401).json({ error: 'MFA session context missing' });
  }

  const decoded = auth.verifyJwt(token);
  if (!decoded) {
    return res.status(401).json({ error: 'MFA session expired' });
  }

  try {
    const user = await db.getUserById(decoded.userId);
    if (!user) {
      return res.status(401).json({ error: 'User not found' });
    }

    let verified = false;
    let updatedBackupCodes = null;

    if (isBackup) {
      const result = mfa.verifyBackupCode(user.backup_codes, code);
      verified = result.verified;
      updatedBackupCodes = result.remainingCodes;
    } else {
      verified = mfa.verifyMfaCode(user.mfa_secret, code);
    }

    if (!verified) {
      return res.status(401).json({ error: isBackup ? 'Invalid backup code' : 'Invalid authenticator code' });
    }

    // If backup code used, update remaining codes in DB
    if (isBackup && updatedBackupCodes) {
      await db.updateUserMFA(user.id, {
        enabled: true,
        secret: user.mfa_secret,
        backupCodes: updatedBackupCodes
      });
    }

    // Success: Upgrade to fully verified session
    const isSecure = req.secure || process.env.NODE_ENV === 'production';
    const accessToken = auth.generateAccessToken(user, true); // mfaVerified = true
    const refreshTokenStr = crypto.randomBytes(40).toString('hex');
    const expiresAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);

    await db.saveRefreshToken(user.id, refreshTokenStr, expiresAt);
    setAuthCookies(res, accessToken, refreshTokenStr, isSecure);

    return res.json({
      success: true,
      accessToken,
      user: sanitizeUser(user)
    });
  } catch (err) {
    console.error('[MFA VERIFY ERROR]', err);
    return res.status(500).json({ error: 'MFA verification failed' });
  }
});

// ── PROTECTED API ROUTES ──────────────────────────────────────

// All API endpoints below require authentication
app.use('/api', auth.requireAuth);

/**
 * Setup MFA TOTP (Get QR Code and Secret)
 */
app.post('/api/mfa/setup', async (req, res) => {
  if (req.user.mfa_enabled) {
    return res.status(400).json({ error: 'MFA is already enabled' });
  }

  try {
    const mfaData = await mfa.generateMfaSecret(req.user.email);
    // Temporarily save secret in DB, but leave mfa_enabled = 0 until verified
    await db.updateUserMFA(req.user.id, {
      enabled: false,
      secret: mfaData.secret,
      backupCodes: null
    });

    return res.json({
      secret: mfaData.secret,
      qrCode: mfaData.qrCodeDataUrl
    });
  } catch (err) {
    return res.status(500).json({ error: 'Failed to initiate MFA setup' });
  }
});

/**
 * Enable MFA (Verify initial TOTP and generate backup codes)
 */
app.post('/api/mfa/enable', async (req, res) => {
  const { code } = req.body;
  if (!code) {
    return res.status(400).json({ error: 'Code is required' });
  }

  if (!req.user.mfa_secret) {
    return res.status(400).json({ error: 'MFA setup has not been initialized' });
  }

  const verified = mfa.verifyMfaCode(req.user.mfa_secret, code);
  if (!verified) {
    return res.status(400).json({ error: 'Invalid verification code' });
  }

  try {
    const { plainCodes, hashedCodes } = mfa.generateBackupCodes(10);
    await db.updateUserMFA(req.user.id, {
      enabled: true,
      secret: req.user.mfa_secret,
      backupCodes: hashedCodes
    });

    console.log(`[MFA] Enabled MFA for user ${req.user.email}`);
    return res.json({
      success: true,
      backupCodes: plainCodes
    });
  } catch (err) {
    return res.status(500).json({ error: 'Failed to enable MFA' });
  }
});

/**
 * Disable MFA
 */
app.post('/api/mfa/disable', auth.requireMFA, async (req, res) => {
  const { code } = req.body;
  if (!code) {
    return res.status(400).json({ error: 'Code is required' });
  }

  const verified = mfa.verifyMfaCode(req.user.mfa_secret, code);
  if (!verified) {
    return res.status(400).json({ error: 'Invalid verification code' });
  }

  try {
    await db.updateUserMFA(req.user.id, {
      enabled: false,
      secret: null,
      backupCodes: null
    });
    console.log(`[MFA] Disabled MFA for user ${req.user.email}`);
    return res.json({ success: true });
  } catch (err) {
    return res.status(500).json({ error: 'Failed to disable MFA' });
  }
});

/**
 * Regenerate MFA Backup codes
 */
app.post('/api/mfa/backup-codes', auth.requireMFA, async (req, res) => {
  try {
    const { plainCodes, hashedCodes } = mfa.generateBackupCodes(10);
    await db.updateUserMFA(req.user.id, {
      enabled: true,
      secret: req.user.mfa_secret,
      backupCodes: hashedCodes
    });
    return res.json({ backupCodes: plainCodes });
  } catch (err) {
    return res.status(500).json({ error: 'Failed to regenerate backup codes' });
  }
});

/**
 * Retrieve MFA Backup codes list status (check if present)
 */
app.get('/api/mfa/backup-codes', auth.requireMFA, async (req, res) => {
  let codes = [];
  if (req.user.backup_codes) {
    try {
      codes = JSON.parse(req.user.backup_codes);
    } catch {}
  }
  return res.json({ count: codes.length });
});

/**
 * Get Practitioner Voice Profile
 */
app.get('/api/voice-profile', async (req, res) => {
  return res.json(sanitizeUser(req.user));
});

/**
 * Update Practitioner Voice Profile
 */
app.put('/api/voice-profile', async (req, res) => {
  try {
    await db.updateUserProfile(req.user.id, req.body);
    // Fetch fresh user
    const updated = await db.getUserById(req.user.id);
    return res.json({ success: true, user: sanitizeUser(updated) });
  } catch (err) {
    return res.status(500).json({ error: 'Failed to update voice profile' });
  }
});

/**
 * Tor network indicator status check
 */
app.get('/api/tor-check', async (req, res) => {
  const clientIp = req.headers['x-forwarded-for'] || req.socket.remoteAddress;
  const isTor = tor.isTorIp(clientIp, req);
  return res.json({ isTor, ip: clientIp });
});

/**
 * AI Generation Endpoint (supports standard and streaming/SSE)
 */
app.post('/api/generate', apiLimiter, auth.requireMFA, async (req, res) => {
  const { docType, context, voiceProfile, stream } = req.body;
  if (!docType || !context) {
    return res.status(400).json({ error: 'docType and context are required' });
  }

  const profile = voiceProfile || req.user;

  try {
    if (stream) {
      await ai.generateStream(docType, context, profile, res);
    } else {
      const text = await ai.generateText(docType, context, profile);
      return res.json({ text });
    }
  } catch (err) {
    return res.status(500).json({ error: 'AI Document Generation failed' });
  }
});

/**
 * Onboarding AI Voice profile extraction
 */
app.post('/api/voice-profile/analyze', apiLimiter, async (req, res) => {
  const { sampleText } = req.body;
  if (!sampleText) {
    return res.status(400).json({ error: 'Sample text is required' });
  }

  try {
    const profile = await ai.analyzeVoiceSample(sampleText);
    return res.json(profile);
  } catch (err) {
    return res.status(500).json({ error: 'Voice analysis failed' });
  }
});

/**
 * Save Document to Database
 */
app.post('/api/documents', auth.requireMFA, async (req, res) => {
  const { name, type, content, status } = req.body;
  if (!name || !type || !content) {
    return res.status(400).json({ error: 'Document name, type, and content are required' });
  }

  try {
    const docId = await db.saveDocument({
      userId: req.user.id,
      name,
      type,
      content,
      status: status || 'Saved'
    });
    return res.json({ success: true, id: docId });
  } catch (err) {
    return res.status(500).json({ error: 'Failed to save document' });
  }
});

/**
 * Get Documents with filter
 */
app.get('/api/documents', auth.requireMFA, async (req, res) => {
  const { type, query } = req.query;
  try {
    const documents = await db.getDocuments(req.user.id, { type, query });
    
    // Map database properties to frontend property casing
    const formattedDocs = documents.map(d => ({
      id: d.id,
      name: d.name,
      type: d.type,
      content: d.content,
      status: d.status,
      date: d.created_at ? d.created_at.split(' ')[0] : new Date().toLocaleDateString('en-US')
    }));

    return res.json({ documents: formattedDocs });
  } catch (err) {
    return res.status(500).json({ error: 'Failed to fetch documents' });
  }
});

/**
 * Delete Document
 */
app.delete('/api/documents/:id', auth.requireMFA, async (req, res) => {
  const docId = parseInt(req.params.id, 10);
  try {
    const success = await db.deleteDocument(docId, req.user.id);
    return res.json({ success });
  } catch (err) {
    return res.status(500).json({ error: 'Failed to delete document' });
  }
});

// ── BILLING ENDPOINTS ─────────────────────────────────────────

/**
 * Create Stripe Checkout session (or mock fallback redirection)
 */
app.post('/api/billing/checkout', auth.requireMFA, async (req, res) => {
  const { plan, annual } = req.body;
  if (!plan) return res.status(400).json({ error: 'Plan is required' });

  try {
    const result = await billing.createCheckoutSession(req.user, plan, annual);
    return res.json(result);
  } catch (err) {
    return res.status(500).json({ error: err.message });
  }
});

/**
 * Create Stripe Customer Portal session (or mock portal link)
 */
app.post('/api/billing/portal', auth.requireMFA, async (req, res) => {
  try {
    const result = await billing.createPortalSession(req.user);
    return res.json(result);
  } catch (err) {
    return res.status(500).json({ error: err.message });
  }
});

/**
 * Mock Checkout success callback route
 */
app.get('/api/billing/mock-checkout-success', async (req, res) => {
  const userId = parseInt(req.query.userId, 10);
  const plan = req.query.plan;

  if (!userId || !plan) {
    return res.status(400).send('Invalid mock checkout parameters');
  }

  try {
    await db.updateUserPlan(userId, plan);
    console.log(`[MOCK BILLING] User ${userId} successfully upgraded to ${plan}`);
    return res.redirect(`/dashboard.html?checkout_success=true&plan=${plan}`);
  } catch (err) {
    return res.status(500).send('Mock billing checkout upgrade failed');
  }
});

/**
 * Developer utility to trigger mock Stripe Webhook updates
 */
app.post('/api/billing/mock-webhook', async (req, res) => {
  const { userId, plan } = req.body;
  if (!userId || !plan) {
    return res.status(400).json({ error: 'userId and plan are required' });
  }

  try {
    await db.updateUserPlan(userId, plan);
    return res.json({ success: true, message: `Mock webhook processed upgrade for ${userId} to ${plan}` });
  } catch (err) {
    return res.status(500).json({ error: 'Mock webhook simulation failed' });
  }
});

// ── FRONTEND PAGE ROUTING (CLEAN URLS) ────────────────────────

const serveHtml = (file) => (req, res) => {
  res.sendFile(path.join(__dirname, file));
};

app.get('/', serveHtml('index.html'));
app.get('/login', serveHtml('login.html'));
app.get('/dashboard', serveHtml('dashboard.html'));
app.get('/onboarding', serveHtml('onboarding.html'));
app.get('/billing', serveHtml('billing.html'));
app.get('/mfa-setup', serveHtml('mfa-setup.html'));
app.get('/mfa-verify', serveHtml('mfa-verify.html'));

// Serve remaining static assets
app.use(express.static(__dirname));

// Error fallback handler
app.use((err, req, res, next) => {
  console.error('[SERVER ERROR]', err.stack);
  res.status(500).json({ error: 'Internal server error' });
});

// Start Server
app.listen(PORT, () => {
  console.log(`=================================================`);
  console.log(` TherapyAdmin AI Backend running at:`);
  console.log(` http://localhost:${PORT}`);
  console.log(`=================================================`);
});
